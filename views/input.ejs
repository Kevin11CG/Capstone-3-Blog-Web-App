<%- include( "./partials/header.ejs" ) %>

<div class="container blog-post-input border border-dark rounded position-fixed top-50 start-50 translate-middle">
    <h1><%= header %></h1>
    <% if (locals.blog) { %>
        <form action="/<%= blog.id %>" method="post">
            <div class="mb-3">
                <input class="post-title-input form-control form-control-lg" type="text" name="title" value="<%= blog.title %>" 
                    placeholder="Title" autofocus autocomplete="off">
            </div>
            <div class="mb-3">
                <textarea class="post-content-input form-control" name="content" id="edit-content" 
                    placeholder="What's happening..." rows="3"><%= blog.content %></textarea>
            </div>
            <div>
                <button type="submit" class="post-submit-btn btn btn-primary">
                    <%= submit %>
                </button>
                <a class="post-cancel-btn btn btn-secondary" href="/<%= blog.id %>">Cancel</a>
            </div>
        </form>
    <% } else { %>
        <form action="/" method="post">
            <div class="mb-3">
                <input class="post-title-input form-control form-control-lg" type="text" name="title"
                    placeholder="Title" autofocus autocomplete="off">
            </div>
            <div class="mb-3">
                <textarea class="post-content-input form-control" name="content" id="new-content"
                    placeholder="What's happening..." rows="3"></textarea>
            </div>
            <div>
                <button type="submit" class="post-submit-btn btn btn-primary"><%= submit %></button>
                <a class="post-cancel-btn btn btn-secondary" href="/">Cancel</a>
            </div>
        </form>
    <% } %>
</div>

<%- include( "./partials/footer.ejs" ) %>