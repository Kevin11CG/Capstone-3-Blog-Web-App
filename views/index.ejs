<%- include( "./partials/header.ejs" ) %>
    
<% if( locals.blog ) { %>
    <div class="container border border-dark rounded">
        <h1><%= blog.title %></h1>
        <p>
            Posted <%= `${ blog.datePosted.toLocaleTimeString( 'en-US', { hour: 'numeric', minute: '2-digit', hour12: true } ) } · 
            ${ months[ blog.datePosted.getMonth() ] } ${ blog.datePosted.getDate() }, 
            ${ blog.datePosted.getFullYear() }` %>
            <% if( blog.isEdited ) { %>
                | Edited <%= `${ blog.dateEdited.toLocaleTimeString( 'en-US', { hour: 'numeric', minute: '2-digit', hour12: true } ) } · 
                ${ months[ blog.dateEdited.getMonth() ] } ${ blog.dateEdited.getDate() }, 
                ${ blog.dateEdited.getFullYear() }` %>
            <% } %>
        </p>
        <p class="blog-content">
            <%= blog.content %>
        </p>
        <div class="d-flex mb-3">
            <form action="/<%= blog.id %>/delete" method="post">
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="btn btn-danger">Delete Post</button>
            </form>
            <a type="button" class="edit-btn btn btn-outline-primary ms-2" href="/<%= blog.id %>/edit">Edit Post</a>
        </div>
    </div>
    
<% } else { %>
    <% if( locals.posts ) { %>
        <div class="container border border-dark rounded">
            <h1 class="mb-4">Blog Posts</h1>
            <ul class="blog-posts-list">
                <% posts.forEach( post => { %>
                    <li>
                        <div class="container-fluid blog-post border border-dark rounded p-3">
                            <h2><a class="blog-link" href="/<%= post.id %>"><%= post.title %></a></h2>
                            <p>
                                Posted <%= `${ post.datePosted.toLocaleTimeString( 'en-US', { hour: 'numeric', minute: '2-digit', hour12: true } ) } · 
                                ${ months[ post.datePosted.getMonth() ] } ${ post.datePosted.getDate() }, 
                                ${ post.datePosted.getFullYear() }` %>
                                <% if( post.isEdited ) { %>
                                    | Edited <%= `${ post.dateEdited.toLocaleTimeString( 'en-US', { hour: 'numeric', minute: '2-digit', hour12: true } ) } · 
                                    ${ months[ post.dateEdited.getMonth() ] } ${ post.dateEdited.getDate() }, 
                                    ${ post.dateEdited.getFullYear() }` %>
                                <% } %>
                            </p>
                        </div>
                        <hr class="blog-post-divider">
                    </li>
                <% } ); %>
            </ul>
        </div>
    <% } %>
<% } %>

<%- include( "./partials/footer.ejs" ) %>